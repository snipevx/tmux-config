## alias for zshrc and tmux
alias zshreload="source ~/.zshrc && echo 'Zsh Reloaded!'"

# tmux session manager
tmux-session-switch() {
    local session=$(tmux list-sessions | fzf --preview "tmux list-windows -t {1}" | awk -F: '{print $1}')

    if [ -n "$session" ]; then
        if [ -n "$TMUX" ]; then
            tmux switch-client -t "$session"
        elif tmux has-session -t "$session" 2>/dev/null; then
            tmux attach-session -t "$session"
        else
            tmux new-session -s "$session"
        fi
    fi
}

# Ensure keybinding works
bindkey -s '^F' 'tmux-session-switch\n'